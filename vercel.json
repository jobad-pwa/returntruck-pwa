{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!locations\\.js|manifest\\.json|sw\\.js|test\\.html|launchericon-192x192\\.png|launchericon-512x512\\.png|.*\\.(?:js|json|png|jpg|jpeg|svg|gif|webp|css|ico|woff|woff2|ttf)$).*)",
      "destination": "/index.html"
    }
  ]
}
